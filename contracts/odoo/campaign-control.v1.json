  "registry_policy_0066": {
    "staging": {
      "reads": "unscoped binding, active",
      "writes": "binding scoped to TEST_SYN only, active",
      "write_binding": {
        "organization_public_id": "TEST_SYN_TENANT",
        "business_unit_public_id": "TEST_SYN",
        "campaign_public_id": "TEST_SYN"
      },
      "saga_enrollment": "events outside write_binding dead-letter at enrollment with SCOPE_NOT_ALLOWED; no Odoo or provider call is made"
    },
    "production": {
      "reads": "unscoped binding, active",
      "writes": "unscoped binding, kill_switch=true until a separate reviewed activation migration",
      "write_binding": null
