{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal://odoo/desired-state/read/v1",
  "title": "Campaign desired-state read (Middleware -> Odoo)",
  "description": "Authoritative desired state for the scope triple. Middleware reads this before every provider side effect. 404 when the campaign does not exist for that organization and business unit.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_public_id",
        "business_unit_public_id",
        "campaign_public_id"
      ],
      "properties": {
        "organization_public_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "business_unit_public_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "campaign_public_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "campaign_public_id",
        "configuration_version",
        "desired_state",
        "manifest_ref",
        "manifest_hash"
      ],
      "properties": {
        "campaign_public_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "configuration_version": {
          "type": "integer",
          "minimum": 0
        },
        "desired_state": {
          "type": "string",
          "enum": [
            "unknown",
            "absent",
            "provisioned_disabled",
            "synthetic_tested",
            "active",
            "disabled"
          ]
        },
        "manifest_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "manifest_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    }
  }
}
